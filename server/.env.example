# ----------------------------------------------------------------------------
# TV Portfolio backend — configuration (copy to server/.env, never commit).
#
# Everything sensitive lives here. The public frontend only knows the API URL
# (js/config.js → CONFIG.auth.apiBaseUrl); it never sees these secrets.
# ----------------------------------------------------------------------------

# Node
PORT=8787
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Must include the exact origin where the portfolio is hosted, e.g.:
# FRONTEND_ORIGINS=https://thiagoovinicioss-hue.github.io
# Add http://localhost:8080 for local development if needed.
FRONTEND_ORIGINS=https://example.github.io,http://localhost:8080

# Set to 1 when the API runs behind a reverse proxy / CDN (Render, Railway,
# nginx, …) so req.ip reflects the real client IP for rate limiting.
TRUST_PROXY=1

# --- WordPress (authentication & authorization layer) ---
# Base URL of your WordPress site (no trailing slash; /wp-json is appended).
WORDPRESS_URL=https://your-wordpress-site.example

# Connector account: a WordPress user with Administrator role. The backend
# authenticates to WordPress with its Application Password (Users → Profile →
# Application Passwords). Never use the site admin's real password here.
WORDPRESS_CONNECT_USER=your-wp-username
WORDPRESS_CONNECT_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# How often (ms) to re-validate a live session against WordPress so that a
# revoked user / changed capability takes effect quickly. 10 minutes default.
WP_RECHECK_MS=600000
# Timeout for each WordPress REST call.
WP_TIMEOUT_MS=8000

# --- Supabase (private lead storage, kept unchanged) ---
SUPABASE_URL=https://your-project.supabase.co
# The SERVICE ROLE key. Server-side only. Found in Supabase →
# Settings → API → service_role. It bypasses Row Level Security, which is why
# this code must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_LEADS_TABLE=leads

# --- Sessions ---
# Absolute lifetime of a session.
SESSION_TTL_MS=28800000
# Cookie name for the session token (HttpOnly, set by the server).
SESSION_COOKIE=tv_session
# Must be "None" (with Secure) because the frontend (GitHub Pages) and this API
# are on different sites. If you serve the frontend and API from the SAME host
# (same origin), you may set COOKIE_SAMESITE=Lax for extra CSRF hardening.
COOKIE_SAMESITE=None
# Cookies are Secure-only. In TLS-terminated production this must be 1.
# Test locally over http://localhost with 1; only set 0 on a plain-HTTP remote
# host you fully control (discouraged).
COOKIE_SECURE=1

# --- Brute-force protection on /api/login ---
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8

# --- DEV-ONLY mocks (never enable in production) ---
# WP_MOCK=1 runs off a built-in fake WordPress that accepts only the exact
# credentials below. SUPABASE_MOCK=1 uses an in-memory leads store. Use these
# only to exercise the flow locally or in tests.
WP_MOCK=0
WP_MOCK_USER=admin
WP_MOCK_PASSWORD=change-me-in-dev
WP_MOCK_USER_ID=1
SUPABASE_MOCK=0