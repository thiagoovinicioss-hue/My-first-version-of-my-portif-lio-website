# ----------------------------------------------------------------------------
# TV Portfolio backend — configuration (copy to server/.env, never commit).
#
# Everything sensitive lives here. The public frontend only knows the API URL
# (js/config.js → CONFIG.auth.apiBaseUrl); it never sees these secrets.
# ----------------------------------------------------------------------------

# Node
PORT=8787
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Must include the exact origin where the portfolio is hosted, e.g.:
# FRONTEND_ORIGINS=https://thiagoovinicioss-hue.github.io
# Add http://localhost:8080 for local development if needed.
FRONTEND_ORIGINS=https://example.github.io,http://localhost:8080

# Set to 1 when the API runs behind a reverse proxy / CDN (Render, Railway,
# nginx, …) so req.ip reflects the real client IP.
TRUST_PROXY=1

# --- Supabase (authentication + private lead storage) ---
SUPABASE_URL=https://your-project.supabase.co
# The SERVICE ROLE key. Server-side only. Found in Supabase →
# Settings → API → service_role. It bypasses Row Level Security, which is why
# this code must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_LEADS_TABLE=leads

# Authorization: the ONLY Supabase Auth user allowed into the private area.
# Copy the admin's UUID from Supabase → Authentication → Users → the admin
# account (e.g. "11111111-...-555555555555"). Empty = fail closed (no access).
ADMIN_USER_ID=

# --- DEV-ONLY mocks (never enable in production) ---
# SUPABASE_MOCK=1 uses an in-memory leads store. SUPABASE_AUTH_MOCK=1 validates
# the two well-known tokens below instead of calling Supabase Auth. Use these
# only to exercise the flow locally or in tests.
SUPABASE_MOCK=0
SUPABASE_AUTH_MOCK=0
AUTH_MOCK_ADMIN_TOKEN=dev-admin-token
AUTH_MOCK_USER_TOKEN=dev-user-token